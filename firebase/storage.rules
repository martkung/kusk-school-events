rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function lineAdminActive() { let config = firestore.get(/databases/(default)/documents/schoolEventSystem/linePilot).data; return config.get('enabled', false) == true && request.auth.uid in config.get('lineAdminUids', []); }
    function admin() { return request.auth != null && request.auth.token.get('admin', false) == true && ((request.auth.token.get('line_login', false) != true && request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'custom') || (request.auth.token.get('line_login', false) == true && request.auth.token.get('line_admin', false) == true && request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'custom' && lineAdminActive())); }
    function delegated(permission) { return request.auth != null && request.auth.token.get('line_login', false) != true && request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'custom' && firestore.exists(/databases/(default)/documents/schoolEventDelegates/$(request.auth.uid)) && firestore.get(/databases/(default)/documents/schoolEventDelegates/$(request.auth.uid)).data.get('active', false) == true && permission in firestore.get(/databases/(default)/documents/schoolEventDelegates/$(request.auth.uid)).data.get('permissions', []); }
    function posterWritable(eventId) {
      let event = firestore.get(/databases/(default)/documents/schoolEventCatalog/$(eventId)).data;
      return event.get('deleted', false) != true && event.get('purging', false) != true;
    }
    match /schoolEventPosters/{eventId}/{file} {
      allow read: if true;
      allow create, update: if (admin() || delegated('posters'))
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg'
        && file.matches('^[A-Za-z0-9-]+[.]jpg$') && posterWritable(eventId);
      allow delete: if admin();
    }
    // Signatures are private evidence; only the authorized server may read/write.
    match /schoolEventSignatures/{rest=**} { allow read, write: if false; }
    // Dormant legacy files are administrative data, not applicant-owned uploads.
    match /schoolEventBanners/{bannerId}/{file} {
      allow read: if true;
      allow create, update: if (admin() || delegated('banners')) && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg'
        && bannerId.matches('^[A-Za-z0-9_-]{1,80}$')
        && file.matches('^[A-Za-z0-9-]+[.]jpg$');
      allow delete: if admin();
    }
    match /{directory}/{rest=**} {
      allow read, write: if directory != 'schoolEventPosters' && directory != 'schoolEventBanners' && directory != 'schoolEventSignatures'
        && admin();
    }
  }
}
